#!/usr/bin/env bash
#
# measure-fallback-node-idle-memory — records the real fallback node's idle memory footprint
# (workload#122 part 4): total/used/free/swap RAM, plus the workload-agent daemon's own RSS, taken
# while the node is holding no live run. This is the number the cloud-fallback-node acceptance
# criterion ("idle footprint is recorded") means — see infra/gcp-fallback-node.tf and
# node/README.md.
#
# "Idle" is on you to arrange before running this: revoke/park any grants on the node
# (`workload admin profiles revoke-grant ...` or the console) and confirm `workload admin runs
# list --worker <fallback-node-id> --live-only --json` is empty first. This script doesn't check
# that for you — a false "idle" reading is worse than an honest failure to produce one.
#
# Usage:
#   ops/measure-fallback-node-idle-memory [options]
#
# Options:
#   --instance NAME   GCE instance name (default: workload-fallback-node).
#   --zone ZONE       GCE zone (default: MEASURE_NODE_ZONE, then europe-west1-b).
#   --project PROJECT GCP project (default: MEASURE_NODE_PROJECT, then gcloud's current config).
#   --out FILE        Append the recorded reading to this file as well as stdout (default: none).
#   -h, --help        Print this help and exit.
#
# Requires: gcloud, authenticated with IAP tunnel access to the instance (see
# infra/gcp-fallback-node.tf's fallback_node_ssh_command output).

set -euo pipefail

script_name="$(basename "${BASH_SOURCE[0]}")"

usage() {
  sed -n '2,24p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

fail() {
  echo "$script_name: $*" >&2
  exit 1
}

instance="workload-fallback-node"
zone="${MEASURE_NODE_ZONE:-europe-west1-b}"
project="${MEASURE_NODE_PROJECT:-}"
out_file=""

while [ $# -gt 0 ]; do
  case "$1" in
    --instance) instance="${2:?--instance requires a value}"; shift 2 ;;
    --zone) zone="${2:?--zone requires a value}"; shift 2 ;;
    --project) project="${2:?--project requires a value}"; shift 2 ;;
    --out) out_file="${2:?--out requires a value}"; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) fail "unknown option: $1 (see --help)" ;;
  esac
done

command -v gcloud >/dev/null 2>&1 || fail "gcloud is required."

project_args=()
[ -n "$project" ] && project_args=(--project "$project")

remote_cmd='
echo "== date =="; date -u
echo "== free -h =="; free -h
echo "== swapon --show =="; swapon --show
echo "== docker ps (should be empty while idle) =="; docker ps --format "table {{.Names}}\t{{.Image}}\t{{.Status}}"
echo "== workload-agent RSS (ps, kB) =="
ps -C java -o pid,rss,pmem,args --sort=-rss 2>/dev/null | head -5 || echo "(no matching java process — is the CLI daemon actually running?)"
echo "== top 10 processes by RSS =="
ps -eo pid,rss,pmem,comm --sort=-rss | head -11
'

echo "== measure-fallback-node-idle-memory: $instance ($zone) =="

reading="$(gcloud compute ssh "$instance" --zone "$zone" "${project_args[@]}" \
  --tunnel-through-iap --command "$remote_cmd" 2>&1)"

echo "$reading"

if [ -n "$out_file" ]; then
  {
    echo "### $(date -u +%Y-%m-%dT%H:%M:%SZ) — $instance ($zone)"
    echo '```'
    echo "$reading"
    echo '```'
    echo
  } >> "$out_file"
  echo "$script_name: appended reading to $out_file" >&2
fi
