<!--
  The CLI's stderr belongs to the operator (and, during `workload worker run`, to the container's own
  streamed output), so framework logging is quiet by default.

  Netty is pinned to ERROR rather than OFF: Armeria sets TCP_USER_TIMEOUT on every channel, which
  Netty warns about on each domain-socket connection ("Unknown channel option ... for channel ...
  EpollDomainSocketChannel") — benign, constant, and pure noise. Silencing the WARN keeps genuine
  Netty errors visible.
-->
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%-5level %logger{0} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="io.netty" level="ERROR" />

  <!--
    Beacon token refreshes are operator signal, not framework noise (M6-A4 observability): one INFO
    line per (re-)claim ("event=beacon.token.refresh …") so "did the brokered credential refresh?"
    is answerable from a run's logs without reproduction. Named to INFO so it surfaces while the root
    stays quiet at WARN. Rare in practice — one line per token lifetime (~hourly), not per request.
  -->
  <logger name="software.medusa.workload.runtime.RefreshingTokenCache" level="INFO" />

  <root level="WARN">
    <appender-ref ref="STDERR" />
  </root>
</configuration>
